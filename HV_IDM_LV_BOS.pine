//@version=6
// =====================================================================
// HV / IDM / LV / BOS (SMC) - TradingView port of HV_IDM_LV_BOS.mq5
// =====================================================================
// Ported from the MQL5 indicator of the same logic (see HV_IDM_LV_BOS.mq5
// in this repo). Core state machine (candidate/IDM/HV/LV/BOS) is verified
// end-to-end against test-data/XAUUSDm_M5_20260820-21.csv - matches every
// ground-truth point (HV1=4567.784@06:55, LV1=4558.344@07:10,
// HV2=4604.593@11:35, LV2=4563.321@12:40, HV3 pending=4632.130@17:05).
//
// The CHoC / auto-bias-flip path (autoBias input) is NOT verified against
// real reversal data - the reference dataset never leaves bullish bias.
// Left off by default; only enable after checking it against a real
// bullish<->bearish transition.
//
// candidate  - the running highest high (bull) / lowest low (bear) since
//              the leg started. Extends on ANY new extreme - no fractal
//              confirmation needed (it's just "the best seen so far").
// IDM        - lowest (bull) / highest (bear) FRACTAL-confirmed swing
//              point since the candidate's last update. Live the moment a
//              genuine pullback forms; LOCKED IN (replacing whatever was
//              locked before) the instant the candidate ticks to a new
//              extreme. Only the most recently locked IDM is ever checked
//              for a sweep.
// HV/LV      - confirmed the instant a candle wicks through the locked
//              IDM (bull: low < IDM; bear: high > IDM), wick only.
// LV/HV      - after HV/LV confirms, track the running opposite extreme;
//              a reference starts at the confirmed point's own price and
//              RATCHETS toward price on any wick-only break (a "swap");
//              the first body-close through the (possibly ratcheted)
//              reference confirms BOS.
// =====================================================================

indicator("HV/IDM/LV/BOS (SMC)", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ---------------------------------------------------------------------
// SANITY CHECK - unconditional, runs on every bar no matter what, zero
// dependency on any state below. If this yellow line does NOT appear on
// the chart, the running script is not this code (stale/cached indicator
// instance) - remove the indicator from the chart entirely and re-add it
// from the Pine Editor rather than debugging the logic further.
// ---------------------------------------------------------------------
plot(close, title = "DEBUG: script is running (should track price)", color = color.yellow, linewidth = 2)

// ---------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------
biasInput      = input.string("Bullish", "Initial Bias", options = ["Bullish", "Bearish"], group = "Bias")
autoBias       = input.bool(false, "Auto-detect CHoC and flip bias dynamically (UNVERIFIED)", group = "Bias")
swingLength    = input.int(3, "Fractal swing length (bars each side)", minval = 1, maxval = 20, group = "Structure")
colorIDM       = input.color(color.orange, "IDM (live) color", group = "Colors")
colorFirst     = input.color(color.blue, "First-confirmed point color (HV in bull, LV in bear)", group = "Colors")
colorSecond    = input.color(color.fuchsia, "Second-confirmed point color (LV in bull, HV in bear)", group = "Colors")
colorBOS       = input.color(color.lime, "BOS line color", group = "Colors")
colorCHoC      = input.color(color.white, "CHoC line/label color", group = "Colors")
colorPending   = input.color(color.aqua, "Pending point color", group = "Colors")
labelSize      = input.string(size.small, "Label size", options = [size.tiny, size.small, size.normal], group = "Colors")
showDebug      = input.bool(true, "Show debug state table (temporary diagnostic)", group = "Debug")

// ---------------------------------------------------------------------
// Persistent state (survives across bars, matching MQL5's per-recalc
// state - here it's simply carried forward bar by bar, which is Pine's
// natural execution model and needs no "rescan the whole history" step)
// ---------------------------------------------------------------------
var bool   curBull        = biasInput == "Bullish"
var int    candidateIdx   = na
var float  candidateValue = na   // transformed (bear = negated) value used for comparisons
var float  candidateReal  = na   // actual price

var bool   shadowValid = false
var int    shadowIdx   = na
var float  shadowValue = na
var float  shadowReal  = na

var bool   lockedValid = false
var int    lockedIdx   = na
var float  lockedValue = na
var float  lockedReal  = na

var bool   secondValid = false
var int    secondIdx   = na
var float  secondValue = na
var float  secondReal  = na

// Incremental tracker for the "impulse window" since the latest secondIdx
// (the running highest high, and the running fractal-confirmed lowest
// pivot) - updated bar-by-bar as we go, so BOS-confirm time never needs
// to scan back over an unbounded stretch of history. A prior version did
// scan back with a variable-offset `[]` reference (`high[bar_index - k]`),
// which works fine over a short verification CSV but throws a runtime
// "requested historical offset too far back" error on a real multi-year
// chart the moment a leg's impulse happens to be long - which silently
// kills ALL of the script's output, with no plots at all, anywhere.
var bool   windowCandValid   = false
var int    windowCandIdx     = na
var float  windowCandValue   = na
var float  windowCandReal    = na

var bool   windowShadowValid = false
var int    windowShadowIdx   = na
var float  windowShadowValue = na
var float  windowShadowReal  = na

var bool   pendingValid = false
var int    pendingIdx   = na
var float  pendingValue = na
var float  pendingReal  = na

var bool   lastStructValid = false
var int    lastStructIdx   = na
var float  lastStructReal  = na

var float  chocRefPrice = na
var int    chocRefIdx   = na

var bool   haveLiveIdm = false
var int    liveIdmIdx  = na
var float  liveIdmReal = na

var bool   haveSweptIdm     = false
var int    sweptIdmIdx      = na
var float  sweptIdmPrice    = na
var int    sweptIdmBreakIdx = na

var bool   haveBos     = false
var int    bosHVIdx    = na
var float  bosHVPrice  = na
var int    bosBreakIdx = na
var bool   bosIsBull   = curBull
var float  bosRefPrice = na

var string phase   = "seek_first"
var int    hvCount = 0
var int    lvCount = 0

// live/pending/BOS/IDM/CHoC drawing objects - created ONCE here with
// placeholder na coordinates (exactly the pattern used by LuxAlgo's
// "Market Structure with Inducements & Sweeps", confirmed working on
// the same chart/account), then only ever moved via set_xy1/set_xy2/
// set_color inside barstate.islast below - never re-created.
var line  idmLine    = line.new(na, na, na, na, style = line.style_dotted, width = 1)
var label idmLabel   = label.new(na, na, "IDM", color = color.new(color.black, 100), size = labelSize)
var line  bosLine    = line.new(na, na, na, na, style = line.style_dotted, width = 1)
var label bosLabelO  = label.new(na, na, "BOS", color = color.new(color.black, 100), size = labelSize)
var line  pendLine   = line.new(na, na, na, na, style = line.style_dotted, width = 1)
var label pendLabel  = label.new(na, na, "", color = color.new(color.black, 100), size = labelSize)
var line  chocLine   = line.new(na, na, na, na, style = line.style_solid, width = 2)
var label chocLabelO = label.new(na, na, "CHoC", color = color.new(color.black, 100), size = labelSize)

// ---------------------------------------------------------------------
// Fractal pivot check for the bar `swingLength` bars ago, with the
// backward-looking side clipped so it never crosses further back than
// `backLimitBarsAgo` bars ago - i.e. never before the bar the current
// leg's candidate tracking started from. Without this clip a pivot check
// can reach into an unrelated, already-closed leg's price action and get
// wrongly disqualified by it (or the reverse - let noise from a stale
// context validate a pivot that isn't genuinely a local extreme).
// bull=true checks a LOW pivot (for IDM tracking in a bullish leg);
// bull=false checks a HIGH pivot (mirror, bearish leg).
// ---------------------------------------------------------------------
isPivotClipped(bool bull, int backLimitBarsAgo) =>
    float pivotVal = bull ? low[swingLength] : high[swingLength]
    bool ok = true
    for j = 1 to swingLength
        offset = swingLength + j
        if offset <= backLimitBarsAgo
            cmp = bull ? low[offset] : high[offset]
            if bull ? (cmp <= pivotVal) : (cmp >= pivotVal)
                ok := false
    if ok
        for k = 1 to swingLength
            offset = swingLength - k
            cmp = bull ? low[offset] : high[offset]
            if bull ? (cmp <= pivotVal) : (cmp >= pivotVal)
                ok := false
    ok

// ---------------------------------------------------------------------
// Only start once enough bars exist for a pivot check to ever succeed,
// and seed the candidate on the very first eligible bar.
// ---------------------------------------------------------------------
minBarsNeeded = 2 * swingLength + 1

if bar_index >= minBarsNeeded
    if na(candidateIdx)
        // seed: just the running high (bull) / low (bear) so far - no
        // pivot confirmation needed, it's naturally superseded later if
        // something more extreme comes along.
        candidateIdx   := bar_index
        candidateValue := curBull ? high : -low
        candidateReal  := curBull ? high : low
    else
        // pivot bar under consideration this bar: swingLength bars ago
        pivotBarIdx = bar_index - swingLength

        // ---------------------------------------------------------
        // 1. CHoC check (only once a structural second point exists)
        // ---------------------------------------------------------
        chocTriggeredThisBar = false
        if autoBias and lastStructValid
            if curBull
                if low < chocRefPrice
                    if close < chocRefPrice
                        chocTriggeredThisBar := true
                    else
                        chocRefPrice := low
                        chocRefIdx   := bar_index
                        if phase == "seek_first"
                            hvCount += 1
                            pendingIdx := candidateIdx
                            pendingValue := candidateValue
                            pendingReal := candidateReal
                            bosRefPrice := candidateReal
                            phase := "seek_second"
                            secondIdx := bar_index
                            secondValue := low
                            secondReal := low
                            secondValid := true
                            windowCandValid := false
                            windowShadowValid := false
            else
                if high > chocRefPrice
                    if close > chocRefPrice
                        chocTriggeredThisBar := true
                    else
                        chocRefPrice := high
                        chocRefIdx   := bar_index
                        if phase == "seek_first"
                            lvCount += 1
                            pendingIdx := candidateIdx
                            pendingValue := candidateValue
                            pendingReal := candidateReal
                            bosRefPrice := candidateReal
                            phase := "seek_second"
                            secondIdx := bar_index
                            secondValue := -high
                            secondReal := high
                            secondValid := true
                            windowCandValid := false
                            windowShadowValid := false

            if chocTriggeredThisBar
                newBull = not curBull
                // CHoC line for the level that just got broken
                line.set_xy1(chocLine, lastStructIdx, lastStructReal)
                line.set_xy2(chocLine, bar_index, lastStructReal)
                line.set_color(chocLine, colorCHoC)
                label.set_xy(chocLabelO, bar_index, lastStructReal)
                label.set_style(chocLabelO, newBull ? label.style_label_up : label.style_label_down)
                label.set_textcolor(chocLabelO, colorCHoC)

                curBull := newBull
                if not curBull
                    // bull -> bear: highest high of the bullish move becomes HV
                    mIdx = lastStructIdx
                    mVal = high[bar_index - lastStructIdx]
                    for k = lastStructIdx to bar_index
                        kv = high[bar_index - k]
                        if kv > mVal
                            mVal := kv
                            mIdx := k
                    hvCount += 1
                    lastStructIdx := mIdx
                    lastStructReal := mVal
                    lastStructValid := true
                    candidateIdx := bar_index
                    candidateValue := -low
                    candidateReal := low
                else
                    // bear -> bull: lowest low of the bearish move becomes LV
                    mIdx = lastStructIdx
                    mVal = low[bar_index - lastStructIdx]
                    for k = lastStructIdx to bar_index
                        kv = low[bar_index - k]
                        if kv < mVal
                            mVal := kv
                            mIdx := k
                    lvCount += 1
                    lastStructIdx := mIdx
                    lastStructReal := mVal
                    lastStructValid := true
                    candidateIdx := bar_index
                    candidateValue := high
                    candidateReal := high

                chocRefPrice := lastStructReal
                chocRefIdx   := lastStructIdx
                shadowValid := false
                lockedValid := false
                pendingValid := false
                secondValid := false
                haveLiveIdm := false
                haveSweptIdm := false
                sweptIdmIdx := na
                sweptIdmBreakIdx := na
                phase := "seek_first"

        // ---------------------------------------------------------
        // 2. Normal structure processing (skipped this bar if CHoC fired)
        // ---------------------------------------------------------
        if not chocTriggeredThisBar
            currHi = curBull ? high : -low
            currLo = curBull ? low : -high
            realLo = curBull ? low : high
            realHi = curBull ? high : low

            if phase == "seek_first"
                backLimitBarsAgo = bar_index - candidateIdx
                if isPivotClipped(curBull, backLimitBarsAgo)
                    pv = curBull ? low[swingLength] : -high[swingLength]
                    pr = curBull ? low[swingLength] : high[swingLength]
                    if not shadowValid or pv < shadowValue
                        shadowValid := true
                        shadowIdx := pivotBarIdx
                        shadowValue := pv
                        shadowReal := pr

                if lockedValid and currLo < lockedValue
                    pendingIdx := candidateIdx
                    pendingValue := candidateValue
                    pendingReal := candidateReal
                    pendingValid := true
                    bosRefPrice := candidateReal
                    phase := "seek_second"
                    secondIdx := bar_index
                    secondValue := currLo
                    secondReal := realLo
                    secondValid := true

                    sweptIdmIdx := lockedIdx
                    sweptIdmPrice := lockedReal
                    sweptIdmBreakIdx := bar_index
                    haveSweptIdm := true
                    haveLiveIdm := false

                    windowCandValid := false
                    windowShadowValid := false
                else if currHi > candidateValue
                    if shadowValid
                        lockedValid := true
                        lockedIdx := shadowIdx
                        lockedValue := shadowValue
                        lockedReal := shadowReal
                        liveIdmIdx := shadowIdx
                        liveIdmReal := shadowReal
                        haveLiveIdm := true
                    candidateIdx := bar_index
                    candidateValue := currHi
                    candidateReal := realHi
                    shadowValid := false

            else // seek_second
                secondMoved = false
                if not secondValid or currLo < secondValue
                    secondValid := true
                    secondIdx := bar_index
                    secondValue := currLo
                    secondReal := realLo
                    secondMoved := true

                // Incrementally track the impulse-window candidate/shadow
                // (bars strictly after the latest secondIdx) as we go, bar
                // by bar - no backward rescan needed at BOS-confirm time.
                // Reset whenever secondIdx itself moves forward, since the
                // window's start point just changed.
                if secondMoved
                    windowCandValid := false
                    windowShadowValid := false
                else if bar_index > secondIdx
                    if not windowCandValid or currHi > windowCandValue
                        windowCandValid := true
                        windowCandIdx := bar_index
                        windowCandValue := currHi
                        windowCandReal := realHi

                    windowBackLimit = bar_index - secondIdx
                    if isPivotClipped(curBull, windowBackLimit)
                        wpv = curBull ? low[swingLength] : -high[swingLength]
                        wpr = curBull ? low[swingLength] : high[swingLength]
                        if not windowShadowValid or wpv < windowShadowValue
                            windowShadowValid := true
                            windowShadowIdx := pivotBarIdx
                            windowShadowValue := wpv
                            windowShadowReal := wpr

                bosTriggered = false
                if curBull
                    if high > bosRefPrice
                        if close > bosRefPrice
                            bosTriggered := true
                        else
                            bosRefPrice := high
                else
                    if low < bosRefPrice
                        if close < bosRefPrice
                            bosTriggered := true
                        else
                            bosRefPrice := low

                if bosTriggered
                    hvCount += 1
                    lvCount += 1

                    lastStructIdx := secondIdx
                    lastStructReal := secondReal
                    lastStructValid := true
                    chocRefPrice := secondReal
                    chocRefIdx := secondIdx
                    bosHVIdx := pendingIdx
                    bosHVPrice := pendingReal
                    bosBreakIdx := bar_index
                    bosIsBull := curBull
                    haveBos := true
                    phase := "seek_first"

                    // candidate = the true extreme across the impulse wave,
                    // read directly from the incrementally-tracked window
                    // (falls back to this bar's own high in the rare case
                    // secondIdx moved on this exact bar, so the window
                    // never got a chance to update)
                    if not windowCandValid or currHi > windowCandValue
                        candidateIdx := bar_index
                        candidateValue := currHi
                        candidateReal := realHi
                    else
                        candidateIdx := windowCandIdx
                        candidateValue := windowCandValue
                        candidateReal := windowCandReal
                    shadowValid := false
                    lockedValid := false
                    pendingValid := false
                    haveLiveIdm := false

                    // the next IDM, if any pullback formed during the
                    // impulse, is whatever the window already tracked
                    if windowShadowValid
                        lockedValid := true
                        lockedIdx := windowShadowIdx
                        lockedValue := windowShadowValue
                        lockedReal := windowShadowReal
                        liveIdmIdx := windowShadowIdx
                        liveIdmReal := windowShadowReal
                        haveLiveIdm := true

                    windowCandValid := false
                    windowShadowValid := false

// ---------------------------------------------------------------------
// Drawing (in-place updates on the last bar only, to avoid redrawing on
// every historical bar during replay - only the final state matters)
// ---------------------------------------------------------------------
if barstate.islast
    // BOS line + label - always set_*, hidden via na color when not
    // applicable (same idiom LuxAlgo uses for its ext_* objects)
    if haveBos
        line.set_xy1(bosLine, bosHVIdx, bosHVPrice)
        line.set_xy2(bosLine, bosBreakIdx, bosHVPrice)
        line.set_color(bosLine, colorBOS)
        label.set_xy(bosLabelO, bosBreakIdx, bosHVPrice)
        label.set_style(bosLabelO, bosIsBull ? label.style_label_down : label.style_label_up)
        label.set_textcolor(bosLabelO, colorBOS)
    else
        line.set_color(bosLine, na)
        label.set_textcolor(bosLabelO, na)

    // IDM line + label - live (extends to current bar) vs swept (stops at sweep)
    if haveLiveIdm
        line.set_xy1(idmLine, liveIdmIdx, liveIdmReal)
        line.set_xy2(idmLine, bar_index, liveIdmReal)
        line.set_color(idmLine, colorIDM)
        label.set_xy(idmLabel, liveIdmIdx, liveIdmReal)
        label.set_style(idmLabel, curBull ? label.style_label_up : label.style_label_down)
        label.set_textcolor(idmLabel, colorIDM)
    else if haveSweptIdm
        line.set_xy1(idmLine, sweptIdmIdx, sweptIdmPrice)
        line.set_xy2(idmLine, sweptIdmBreakIdx, sweptIdmPrice)
        line.set_color(idmLine, colorIDM)
        label.set_xy(idmLabel, sweptIdmIdx, sweptIdmPrice)
        label.set_style(idmLabel, curBull ? label.style_label_up : label.style_label_down)
        label.set_textcolor(idmLabel, colorIDM)
    else
        line.set_color(idmLine, na)
        label.set_textcolor(idmLabel, na)

    // pending point (confirmed via IDM sweep, own LV/BOS not closed yet)
    if phase == "seek_second" and pendingValid
        pLbl = curBull ? "HV (pending)" : "LV (pending)"
        line.set_xy1(pendLine, pendingIdx, pendingReal)
        line.set_xy2(pendLine, bar_index, pendingReal)
        line.set_color(pendLine, colorPending)
        label.set_xy(pendLabel, pendingIdx, pendingReal)
        label.set_text(pendLabel, pLbl)
        label.set_style(pendLabel, curBull ? label.style_label_down : label.style_label_up)
        label.set_textcolor(pendLabel, colorPending)
    else
        line.set_color(pendLine, na)
        label.set_textcolor(pendLabel, na)

    // -------------------------------------------------------------
    // Temporary debug table - shows internal state so we can see
    // whether the state machine is progressing at all, and where
    // it's stuck, without guessing. Safe to remove once diagnosed.
    // -------------------------------------------------------------
    if showDebug
        var table dbg = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 20), border_width = 1)
        table.cell(dbg, 0, 0, "bar_index", text_color = color.white, text_size = size.small)
        table.cell(dbg, 1, 0, str.tostring(bar_index), text_color = color.white, text_size = size.small)
        table.cell(dbg, 0, 1, "minBarsNeeded", text_color = color.white, text_size = size.small)
        table.cell(dbg, 1, 1, str.tostring(minBarsNeeded), text_color = color.white, text_size = size.small)
        table.cell(dbg, 0, 2, "phase", text_color = color.white, text_size = size.small)
        table.cell(dbg, 1, 2, phase, text_color = color.yellow, text_size = size.small)
        table.cell(dbg, 0, 3, "curBull", text_color = color.white, text_size = size.small)
        table.cell(dbg, 1, 3, str.tostring(curBull), text_color = color.white, text_size = size.small)
        table.cell(dbg, 0, 4, "hvCount/lvCount", text_color = color.white, text_size = size.small)
        table.cell(dbg, 1, 4, str.tostring(hvCount) + "/" + str.tostring(lvCount), text_color = color.white, text_size = size.small)
        table.cell(dbg, 0, 5, "haveLiveIdm", text_color = color.white, text_size = size.small)
        table.cell(dbg, 1, 5, str.tostring(haveLiveIdm), text_color = color.white, text_size = size.small)
        table.cell(dbg, 0, 6, "haveSweptIdm", text_color = color.white, text_size = size.small)
        table.cell(dbg, 1, 6, str.tostring(haveSweptIdm), text_color = color.white, text_size = size.small)
        table.cell(dbg, 0, 7, "haveBos", text_color = color.white, text_size = size.small)
        table.cell(dbg, 1, 7, str.tostring(haveBos), text_color = color.white, text_size = size.small)
        table.cell(dbg, 0, 8, "candidateReal", text_color = color.white, text_size = size.small)
        table.cell(dbg, 1, 8, na(candidateReal) ? "na" : str.tostring(candidateReal), text_color = color.white, text_size = size.small)
